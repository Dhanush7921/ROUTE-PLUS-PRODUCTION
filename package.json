{
  "name": "route-plus",
  "version": "0.2.0",
  "private": true,
  "description": "ROUTE+ — route-aware discovery and detour decisions for Indian road trips",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "build": "node scripts/build-standalone.mjs",
    "worker": "node --disable-warning=ExperimentalWarning scripts/worker.mjs",
    "check:live": "node --disable-warning=ExperimentalWarning scripts/check-live-providers.mjs",
    "check:google": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/check-google.mjs",
    "db:pg": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/db-postgres.mjs",
    "check:beta": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/check-beta.mjs",
    "db:backup": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/db-backup.mjs",
    "db:restore:verify": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/db-restore-verify.mjs",
    "audit:routes": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/audit-pg-routes.mjs",
    "audit:http": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/phase8-http-pg.mjs",
    "beta:signals": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/beta-signals.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:unit": "node --disable-warning=ExperimentalWarning --test tests/unit/*.test.mjs",
    "test:integration": "node --disable-warning=ExperimentalWarning --test tests/integration/*.test.mjs",
    "test:e2e": "node --disable-warning=ExperimentalWarning scripts/run-e2e.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
