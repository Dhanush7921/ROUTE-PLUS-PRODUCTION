# Copy to .env (never commit .env — it is in .gitignore) or set these in your
# hosting dashboard. EVERYTHING IS OPTIONAL: with no .env, ROUTE+ runs fully
# offline (offline road network + curated places).

PORT=8080
HOST=127.0.0.1                 # use 0.0.0.0 inside Docker / on a server
TRUST_PROXY=0                  # 1 ONLY when a reverse proxy you control sets X-Forwarded-For.
                               # Without it every visitor behind the proxy shares one rate-limit
                               # bucket; with it set but no proxy, clients can forge their address.
SHUTDOWN_TIMEOUT_MS=10000      # how long a graceful stop waits for in-flight requests
PUBLIC_URL=                    # e.g. https://routeplus.example — enables Secure cookies, HSTS, origin checks
ROUTE_PLUS_DB=./data/routeplus.sqlite    # SQLite: the default, needs no setup

# ---------------------------------------------------------------------------
# PRODUCTION DATABASE — PostgreSQL (+ PostGIS when available).
# Leave EMPTY for local development: ROUTE+ then runs entirely on SQLite.
# When set, `npm run db:pg -- status | migrate | seed | import | verify` manage
# the production schema, and the server reports the connection at startup.
# The password is never logged, never returned by the API, never committed.
#   DATABASE_URL=postgres://routeplus:YOUR_PASSWORD@localhost:5432/routeplus?sslmode=require
# Or the standard variables instead of a URL:
#   PGHOST=  PGPORT=5432  PGDATABASE=routeplus  PGUSER=routeplus  PGPASSWORD=
# PGSSLMODE: require (managed services) | prefer (default) | disable (local)
DATABASE_URL=
PGSSLMODE=prefer
SESSION_DAYS=30
ADMIN_EMAILS=                  # comma-separated; these sign-ups get the admin role
LOG_LEVEL=info                 # debug | info | warn | error | silent

# ---------------------------------------------------------------------------
# MAP PROVIDER SELECTION. Defaults are offline.
#   ROUTE_PROVIDER      offline | osrm      | google   ← google = LIVE Routes API
#   GEOCODING_PROVIDER  offline | nominatim | google   ← google = LIVE Geocoding API
#   PLACE_PROVIDER      curated | overpass  | google   ← google is a boundary only
# If a choice cannot work (missing key, unknown name) the server logs a warning
# and uses offline instead. Offline is always the fallback at request time too.
#
# To use real Google road routing and real Google geocoding, set the two below
# to google, put a restricted server key in GOOGLE_MAPS_SERVER_KEY, and enable
# the Geocoding API and the Routes API (with billing) in Google Cloud Console.
# Cost per journey: 2 geocoding requests + 1 Routes request (results are cached).
# Detour +km / +min figures are still ROUTE+ estimates in this step.
ROUTE_PROVIDER=offline
GEOCODING_PROVIDER=offline
PLACE_PROVIDER=curated

# ---------------------------------------------------------------------------
# GOOGLE MAPS PLATFORM KEYS — leave empty until you have real, restricted keys.
# Two SEPARATE keys:
#
# GOOGLE_MAPS_BROWSER_KEY  → for Maps JavaScript API in the browser (map display, later step).
#   It is visible to anyone using the site, so in Google Cloud Console restrict it:
#   Application restriction = Websites (HTTP referrers): your domain(s), e.g. https://routeplus.example/*
#   API restriction         = Maps JavaScript API only.
#
# GOOGLE_MAPS_SERVER_KEY   → for server-side web services (Routes API, Geocoding API).
#   NEVER sent to the browser, never returned by the API, never logged.
#   Application restriction = IP addresses (your server's public IP).
#   API restriction         = Routes API + Geocoding API (add Places API (New) later).
#   Check it works:  npm run check:google   (2 geocodes + 1 route, nothing stored)
#
# Also: set a billing budget + alerts and per-API quotas in Google Cloud Console.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=

# ---------------------------------------------------------------------------
# OpenStreetMap-based live providers (osrm / nominatim / overpass) and weather.
ROUTE_PLUS_LIVE_PROVIDERS=0    # legacy shortcut: 1 = osrm + nominatim + overpass + weather
ROUTE_PLUS_CONTACT=            # REQUIRED for OpenStreetMap services: your email (usage policy)
OSRM_URL=https://router.project-osrm.org          # demo server, fair use only — self-host for production
OSRM_DURATION_FACTOR=1.2                          # OSRM assumes free-flowing traffic; scale for Indian roads
NOMINATIM_URL=https://nominatim.openstreetmap.org # max 1 request/second
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URL=                            # optional second instance, e.g. https://overpass.kumi.systems/api/interpreter
                                                  # tried ONLY after the primary fails for a chunk — never both at once
OVERPASS_CHUNK_KM=120                             # km of route per Overpass request; smaller = cheaper queries, more of them
MAX_DETOUR_CANDIDATES=120                         # corridor places given a REAL road-network detour (3 router legs each).
                                                  # Lower it if the public OSRM demo server is slow or rate-limits you.
CACHE_TTL_HOURS=12
